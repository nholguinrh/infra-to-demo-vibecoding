FROM docker.io/rocker/r-ver:4.4.1 AS base

WORKDIR /workspace

RUN Rscript -e 'install.packages(c("plumber", "testthat"), Ncpus = 2)'

FROM base AS dev

EXPOSE 8000
CMD ["Rscript", "-e", "plumber::pr('plumber.R')$run(host='0.0.0.0', port=8000)"]

FROM base AS prod

RUN useradd --create-home --uid 1001 app

COPY app/ /workspace/

USER app
EXPOSE 8000
CMD ["Rscript", "-e", "plumber::pr('plumber.R')$run(host='0.0.0.0', port=8000)"]
