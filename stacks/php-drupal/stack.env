STACK_LANG=php
STACK_DESCRIPTION="Drupal 11 + PHP 8.3 + Apache"
STACK_CONTAINER_PORT=80
STACK_APP_PORT_DEFAULT=8080
STACK_SHELL=bash
STACK_RUN_WORKDIR=/workspace
STACK_TEST_CMD="composer validate --no-check-publish && find modules -type f \\( -name '*.php' -o -name '*.module' \\) -print0 | xargs -0 -r -n1 php -l"
STACK_LINT_CMD="composer validate --no-check-publish && find modules -type f \\( -name '*.php' -o -name '*.module' \\) -print0 | xargs -0 -r -n1 php -l"
STACK_FMT_CMD=""
STACK_FMT_CHECK_CMD=""
