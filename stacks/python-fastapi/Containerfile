FROM docker.io/library/python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /workspace

COPY stacks/python-fastapi/template/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

FROM base AS dev

COPY stacks/python-fastapi/template/requirements-dev.txt /tmp/requirements-dev.txt
RUN pip install --no-cache-dir -r /tmp/requirements-dev.txt

EXPOSE 8000
CMD ["sh", "-lc", "exec uvicorn main:app --host 0.0.0.0 --port 8000 --reload"]

FROM base AS prod

RUN groupadd --gid 1001 app \
    && useradd --uid 1001 --gid app --create-home app

COPY app/ /workspace/

USER app
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
