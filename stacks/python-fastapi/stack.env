STACK_LANG=python
STACK_DESCRIPTION="Python 3.12 + FastAPI"
STACK_CONTAINER_PORT=8000
STACK_APP_PORT_DEFAULT=8000
STACK_SHELL=bash
STACK_RUN_WORKDIR=/workspace
STACK_TEST_CMD="pytest -q -p no:cacheprovider"
STACK_LINT_CMD="ruff check --no-cache ."
STACK_FMT_CMD="ruff format --no-cache . && ruff check --no-cache --fix ."
STACK_FMT_CHECK_CMD="ruff format --no-cache --check ."
